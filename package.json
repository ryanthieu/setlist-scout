{
  "name": "setlist-scout",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "biome check .",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "dev:worker": "pnpm --filter @setlist-scout/worker run dev",
    "dev:extension": "pnpm --filter @setlist-scout/extension run dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "typescript": "^7.0.2"
  }
}
